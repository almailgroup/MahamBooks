{
  "name": "maham-books",
  "private": true,
  "version": "0.1.0",
  "description": "Maham Books: accounting, invoicing and payroll for Kuwaiti businesses, in Arabic and English. Runs in the browser, with optional cloud sync.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
